{
  "version": "0.1.0",
  "name": "aegis_registry",
  "instructions": [
    {
      "name": "postReceipt",
      "accounts": [
        { "name": "receiptAccount", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "receiptHash", "type": { "array": ["u8", 32] } },
        { "name": "manifestHash", "type": { "array": ["u8", 32] } },
        { "name": "policyHash", "type": { "array": ["u8", 32] } },
        { "name": "bundleHash", "type": { "array": ["u8", 32] } },
        { "name": "bundleUri", "type": "string" },
        { "name": "ledgerRoot", "type": { "array": ["u8", 32] } }
      ]
    },
    {
      "name": "submitAttestation",
      "accounts": [
        { "name": "attestationAccount", "isMut": true, "isSigner": false },
        { "name": "receiptAccount", "isMut": true, "isSigner": false },
        { "name": "verifier", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "receiptHash", "type": { "array": ["u8", 32] } },
        { "name": "verdict", "type": { "defined": "AttestationVerdict" } },
        { "name": "signature", "type": "bytes" },
        { "name": "proofPointer", "type": "string" }
      ]
    },
    {
      "name": "finalizeReceipt",
      "accounts": [
        { "name": "receiptAccount", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "quorum", "type": "u8" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "ReceiptAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "receiptId", "type": "publicKey" },
          { "name": "manifestHash", "type": { "array": ["u8", 32] } },
          { "name": "policyHash", "type": { "array": ["u8", 32] } },
          { "name": "bundleHash", "type": { "array": ["u8", 32] } },
          { "name": "bundleUri", "type": "string" },
          { "name": "ledgerRoot", "type": { "array": ["u8", 32] } },
          { "name": "status", "type": { "defined": "ReceiptStatus" } },
          { "name": "createdAt", "type": "i64" },
          { "name": "updatedAt", "type": "i64" }
