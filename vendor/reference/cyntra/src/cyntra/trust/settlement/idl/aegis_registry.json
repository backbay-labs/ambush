    },
    {
      "name": "AttestationVerdict",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Reject" },
          { "name": "Approve" }
        ]
      }
    }
  ],
  "metadata": {
    "address": "BHSQshFJE2rL99ekisK62RWkqZ8foDNCbf1vwBPHWYEh"
