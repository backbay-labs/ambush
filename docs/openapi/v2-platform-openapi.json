  "info": {
    "description": "Machine-readable contract for the shipped `/v2/api/*` read surface on the detect server. Requests require both an operator bearer token and a platform API key unless a scoped Providence context token is used on the supported read routes.",
    "summary": "Authenticated read surface for findings, incidents, runtime status, posture, and evasion coverage.",
    "title": "Swarm Team Six Platform API",
    "version": "v2-schema-1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.0",
  "paths": {
    "/v2/api/assets/{host_id}/posture": {
      "get": {
        "description": "Returns threat concentration, active investigations, and recent findings for one host.",
        "operationId": "get_asset_posture",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersionHeader"
          },
          {
            "$ref": "#/components/parameters/HostIdPath"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformAssetPosturePage"
                }
              }
            },
            "description": "Successful response."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid authentication"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authenticated principal lacks required scope"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying the request.",
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requested platform API surface is unavailable"
          }
        },
        "summary": "Read asset posture",
        "tags": [
          "platform"
        ]
      }
    },
    "/v2/api/evasion/coverage": {
      "get": {
        "description": "Returns the repo-owned evasion coverage snapshot, optionally filtered to one detector family.",
        "operationId": "get_evasion_coverage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersionHeader"
          },
          {
            "description": "Optional detector family to filter from the coverage snapshot.",
            "in": "query",
            "name": "detector",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvasionCoverageSnapshot"
                }
              }
            },
            "description": "Successful response."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
