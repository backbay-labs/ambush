# Copy to .env.perch (git-ignored) and fill in.
#
#   cp .env.perch.example .env.perch
#   printf 'PERCH_BRIDGE_NOSTR_SEED=%s\n' "$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >> .env.perch
#
# docker-compose.yml reads this file into the `swarm-detect` service
# (`env_file`), and `set -a; . ./.env.perch; set +a` puts the same values in
# front of a laptop-run daemon. Nothing here is a production credential.

# The 32-byte root of the bridge's secp256k1 key derivation (00-DECISIONS.md
# D-FC-1): 64 lowercase hex characters, read once at startup from the variable
# named by `perch.nostr_seed_env` in rulesets-dev/perch-dev.yaml. Unset, short,
# or not hex and the bridge refuses to start rather than publish under a key
# nobody chose. Changing it after first provisioning rotates all three bridge
# identities and invalidates every relay membership they hold.
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
PERCH_BRIDGE_NOSTR_SEED=

# The operator-surface bearer the console and curl send. It is the token_env of
# the `console` principal in rulesets-dev/perch-dev.yaml
# (operator_surface.auth.principals[].token_env), and it is the second of the two
# layers the platform read API checks.
SWARM_OPERATOR_TOKEN=dev-token-not-a-secret

# The first of those two layers: the `x-api-key` header on /v2/api/*, matched
# against sha256 of this value in the ruleset's `platform_api.keys`. Send only
# the bearer above and the surface answers 401 `missing x-api-key header`.
# Change this and you must re-hash it into the ruleset and re-sign:
#   python3 -c 'import hashlib;print(hashlib.sha256(b"<value>").hexdigest())'
SWARM_PLATFORM_API_TOKEN=dev-platform-token
